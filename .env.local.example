# 複製這個檔案為 .env.local(不要進 git),填入真實的值。
# 這些金鑰從 Supabase 專案的 Settings -> API 頁面取得。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key 只在之後需要 server 端管理操作(例如 admin 建帳號)時才會用到,
# 絕對不能加 NEXT_PUBLIC_ 前綴、絕對不能暴露到瀏覽器端。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
